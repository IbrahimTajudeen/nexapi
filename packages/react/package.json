{
  "name": "@nyxapi/react",
  "version": "0.1.0",
  "description": "React hooks for NyxAPI built on @nyxapi/core",
  "keywords": [
    "nyxapi",
    "react",
    "hooks",
    "api-client",
    "query-cache",
    "suspense",
    "openapi"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "@nyxapi/core": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
