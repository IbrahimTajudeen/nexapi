{
  "name": "@nyxapi/cli",
  "version": "0.1.0",
  "description": "The `nyx` command: generate typed clients from OpenAPI, Swagger 2.0 or GraphQL",
  "keywords": [
    "nyxapi",
    "openapi",
    "graphql",
    "cli",
    "typescript",
    "codegen",
    "api-client"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "bin": {
    "nyx": "./dist/cli.js",
    "nyxapi": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "@nyxapi/codegen": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
