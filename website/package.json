{
  "name": "@nyxapi/website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "prepare:site": "node scripts/prepare-downloads.mjs",
    "predev": "node scripts/prepare-downloads.mjs",
    "dev": "next dev --webpack",
    "prebuild": "node scripts/prepare-downloads.mjs",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "generate:api": "node scripts/generate-openapi.mjs && node ../packages/cli/dist/cli.js generate",
    "generate:api:check": "node scripts/generate-openapi.mjs --check && node ../packages/cli/dist/cli.js generate --check"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@nyxapi/codegen": "workspace:*",
    "@nyxapi/core": "workspace:*",
    "@nyxapi/devtools": "workspace:*",
    "@nyxapi/react": "workspace:*",
    "@supabase/supabase-js": "^2.118.0",
    "codemirror": "^6.0.2",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sucrase": "^3.35.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "~5.9.3"
  }
}
