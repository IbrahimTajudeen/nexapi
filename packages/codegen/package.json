{
  "name": "@nyxapi/codegen",
  "version": "0.1.0",
  "description": "OpenAPI, Swagger 2.0 and GraphQL to typed TypeScript client generator for NyxAPI",
  "keywords": [
    "nyxapi",
    "openapi",
    "codegen",
    "typescript",
    "api-client",
    "code-generator",
    "swagger",
    "graphql"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12"
  },
  "files": [
    "dist",
    "config.schema.json",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./config.schema.json": "./config.schema.json"
  },
  "dependencies": {
    "graphql": "^16.14.2",
    "yaml": "^2.9.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
