{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "baseUrl": ".",
    "paths": {
      "@nyxapi/core": ["packages/core/src/index.ts"],
      "@nyxapi/codegen": ["packages/codegen/src/index.ts"],
      "@nyxapi/react": ["packages/react/src/index.ts"],
      "@nyxapi/graphql": ["packages/graphql/src/index.ts"],
      "@nyxapi/trpc": ["packages/trpc/src/index.ts"],
      "@nyxapi/devtools": ["packages/devtools/src/index.ts"],
      "@nyxapi/devtools/react": ["packages/devtools/src/react.tsx"]
    }
  },
  "include": [
    "packages/*/src",
    "packages/*/test",
    "tests",
    "examples/*/src",
    "examples/*/generated",
    "vitest.config.ts"
  ]
}
