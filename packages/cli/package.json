{
  "name": "@nyxapi/cli",
  "version": "0.0.1",
  "description": "Schema validation and client generation commands for NyxAPI",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "bin": {
    "nyxapi": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "@nyxapi/codegen": "workspace:*"
  }
}
