    "api-client",
    "query-cache",
    "mutations",
    "optimistic-updates",
    "fetch",
    "typescript",
    "openapi"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
