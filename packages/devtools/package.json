{
  "name": "@nyxapi/devtools",
  "version": "0.1.0",
  "description": "Cache inspector and React panel for NyxAPI",
  "keywords": [
    "nyxapi",
    "devtools",
    "react",
    "query-cache",
    "debugging",
    "openapi"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    }
  },
  "dependencies": {
    "@nyxapi/core": "workspace:*",
    "@nyxapi/react": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
