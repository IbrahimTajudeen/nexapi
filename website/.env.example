# Copy to .env.local for development, or set these in your host's build settings.
# They are inlined at build time (the site is a static export), so rebuild after changing them.
# Every value here is public by design. Never put a Supabase service_role key in this site.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your-unsigned-preset-name

# Optional: try the admin panel with no accounts. Data stays in your browser and is not shared.
# Do not set this on a real deployment.
# NEXT_PUBLIC_BACKEND=demo
