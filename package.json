{
  "name": "nexapi-monorepo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "clean": "tsc -b tsconfig.build.json --clean && rm -rf packages/*/dist",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:example": "pnpm build && node scripts/generate-examples.mjs",
    "generate:check": "pnpm build && node scripts/generate-examples.mjs --check",
    "bench": "pnpm --filter @nexapi/benchmarks bench",
    "website:dev": "pnpm --filter @nexapi/website dev",
    "website:build": "pnpm --filter @nexapi/website build",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm generate:check",
    "smoke:pack": "pnpm build && node scripts/smoke-pack.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^10.12.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  }
}
