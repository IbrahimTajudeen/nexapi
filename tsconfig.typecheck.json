{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "baseUrl": ".",
    "paths": {
      "@syncapi/core": ["packages/core/src/index.ts"],
      "@syncapi/codegen": ["packages/codegen/src/index.ts"],
      "@syncapi/react": ["packages/react/src/index.ts"]
    }
  },
  "include": [
    "packages/*/src",
    "packages/*/test",
    "tests",
    "examples/*/src",
    "examples/*/generated",
    "vitest.config.ts"
  ]
}
