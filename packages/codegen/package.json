{
  "name": "@nyxapi/codegen",
  "version": "0.0.1",
  "description": "OpenAPI parser, normalized API model and TypeScript generator for NyxAPI",
  "keywords": [
    "nyxapi",
    "openapi",
    "codegen",
    "typescript",
    "api-client",
    "code-generator",
    "swagger"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
