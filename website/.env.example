# Copy to .env.local for development, or set these in Vercel (Project Settings, Environment Variables).
# The site is a Next.js app with route handlers under /api, so server variables are read at run time.
# Never put a Supabase service_role key in this site.

# Server (route handlers). May be omitted if the NEXT_PUBLIC_ twins below are set.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# Browser: magic-link sign-in. Inlined at build time, so redeploy after changing them.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Cloudinary: the server signs uploads and deletes. The secret must NOT have a NEXT_PUBLIC_ prefix.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Optional: try the admin panel with no accounts. Data stays in your browser and is not shared.
# Do not set this on a real deployment.
# NEXT_PUBLIC_BACKEND=demo
