#!/bin/sh
# NyxAPI installer (version __VERSION__)
#
# Downloads the NyxAPI package tarballs from the site you ran this from, checks their SHA-256
# sums, saves them in ./.nyxapi/ and installs them with your package manager.
#
#   curl -fsSL https://YOUR-SITE/install.sh | sh -s -- https://YOUR-SITE
#
# Environment:
#   NYXAPI_PACKAGES  space-separated list (default: "core cli codegen"; also: react devtools)
#   NYXAPI_PM        npm | pnpm | yarn | bun (default: detected from your lockfile, else npm)
#
# Read it first if you like: it only downloads from the site you give it, writes to ./.nyxapi/
# and runs "<package manager> add/install" for those files.
set -eu

VERSION="__VERSION__"
BASE="${1:-${NYXAPI_BASE:-}}"
if [ -z "$BASE" ]; then
  echo "usage: curl -fsSL <site>/install.sh | sh -s -- <site-url>" >&2
  exit 1
fi
BASE="${BASE%/}"
PACKAGES="${NYXAPI_PACKAGES:-core cli codegen}"

if [ ! -f package.json ]; then
  echo "No package.json here. Run this inside your project (npm init -y creates one)." >&2
  exit 1
fi

PM="${NYXAPI_PM:-}"
if [ -z "$PM" ]; then
  if [ -f pnpm-lock.yaml ]; then PM=pnpm
  elif [ -f yarn.lock ]; then PM=yarn
  elif [ -f bun.lockb ] || [ -f bun.lock ]; then PM=bun
  else PM=npm
  fi
fi
command -v "$PM" >/dev/null 2>&1 || { echo "$PM was not found on your PATH." >&2; exit 1; }
command -v curl >/dev/null 2>&1 || { echo "curl was not found on your PATH." >&2; exit 1; }

DIR=".nyxapi"
mkdir -p "$DIR"

echo "Downloading checksums from $BASE/downloads/SHA256SUMS"
curl -fsSL "$BASE/downloads/SHA256SUMS" -o "$DIR/SHA256SUMS"

sha256_of() {
  if command -v sha256sum >/dev/null 2>&1; then sha256sum "$1" | cut -d' ' -f1
  elif command -v shasum >/dev/null 2>&1; then shasum -a 256 "$1" | cut -d' ' -f1
  else echo ""
  fi
}

RUNTIME=""
DEV=""
MAP=""
for pkg in $PACKAGES; do
  file="nyxapi-$pkg-$VERSION.tgz"
  echo "Downloading $file"
  curl -fsSL "$BASE/downloads/$file" -o "$DIR/$file"
  expected="$(grep "  $file\$" "$DIR/SHA256SUMS" | cut -d' ' -f1)"
  actual="$(sha256_of "$DIR/$file")"
  if [ -z "$expected" ]; then echo "No checksum listed for $file" >&2; exit 1; fi
  if [ -n "$actual" ] && [ "$actual" != "$expected" ]; then
    echo "Checksum mismatch for $file. Expected $expected but got $actual. Nothing was installed." >&2
    exit 1
  fi
  if [ -z "$actual" ]; then echo "Warning: no sha256sum or shasum found, so $file was not verified." >&2; fi
  MAP="$MAP @nyxapi/$pkg=file:./$DIR/$file"
  case "$pkg" in
    cli|codegen|devtools) DEV="$DEV file:./$DIR/$file" ;;
    *) RUNTIME="$RUNTIME file:./$DIR/$file" ;;
  esac
done

# The packages depend on each other and are not on the registry yet, so list every @nyxapi/*
# package as a file dependency (and, where the package manager needs it, as an override), then
# install normally. Otherwise the package manager would look the dependencies up online.
command -v node >/dev/null 2>&1 || { echo "node was not found on your PATH." >&2; exit 1; }
NYXAPI_RUNTIME="$RUNTIME" NYXAPI_DEV="$DEV" NYXAPI_MAP="$MAP" NYXAPI_PM_NAME="$PM" node -e '
const fs = require("fs");
const pkg = JSON.parse(fs.readFileSync("package.json", "utf8"));
const pairs = (v) => v.trim().split(/\s+/).filter(Boolean).map((spec) => {
  const file = spec.replace(/^file:/, "");
  const name = "@nyxapi/" + file.replace(/^.*nyxapi-/, "").replace(/-[0-9][^/]*\.tgz$/, "");
  return [name, spec];
});
const runtime = Object.fromEntries(pairs(process.env.NYXAPI_RUNTIME));
const dev = Object.fromEntries(pairs(process.env.NYXAPI_DEV));
pkg.dependencies = { ...pkg.dependencies, ...runtime };
pkg.devDependencies = { ...pkg.devDependencies, ...dev };
const map = Object.fromEntries(process.env.NYXAPI_MAP.trim().split(/\s+/).map((e) => e.split("=")));
const pm = process.env.NYXAPI_PM_NAME;
if (pm === "pnpm") { pkg.pnpm = pkg.pnpm || {}; pkg.pnpm.overrides = { ...pkg.pnpm.overrides, ...map }; }
else if (pm === "yarn") pkg.resolutions = { ...pkg.resolutions, ...Object.fromEntries(Object.entries(map).map(([k, v]) => ["**/" + k, v])) };
else if (pm === "bun") pkg.overrides = { ...pkg.overrides, ...map };
fs.writeFileSync("package.json", JSON.stringify(pkg, null, 2) + "\n");
'

"$PM" install

echo
echo "NyxAPI $VERSION installed with $PM. Next:"
echo "  npx nyxapi generate --input ./openapi.yaml --output ./src/api"
